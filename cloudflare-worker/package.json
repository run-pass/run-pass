{
  "private": true,
  "name": "cloudflare-worker-passbook",
  "version": "1.1.0",
  "description": "A template for kick starting a Cloudflare Workers project that creates a passbook",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/*.{ts,tsx,js,css,json,md}'"
  },
  "author": "GitHub <noreply@github.com>",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.1",
    "@cloudflare/workers-types": "^4.20260430.1",
    "prettier": "^1.18.2",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.16",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.3",
    "passkit-generator": "^3.1.4"
  }
}
