{
  "private": true,
  "name": "cloudflare-worker-passbook",
  "version": "1.1.0",
  "description": "A template for kick starting a Cloudflare Workers project that creates a passbook",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/*.{ts,tsx,js,css,json,md}'"
  },
  "author": "GitHub <noreply@github.com>",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.5",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.10",
    "passkit-generator": "^3.5.7"
  }
}
