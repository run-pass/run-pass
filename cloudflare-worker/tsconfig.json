{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022"],
    "alwaysStrict": true,
    "strict": true,
    "preserveConstEnums": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src", "test", "vitest.config.ts", "../frontend/src/assets/park_runs.ts"],
  "exclude": ["node_modules", "dist"]
}
